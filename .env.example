# ─────────────────────────────────────────────────────────────────────────
# Umer Designs — Frontend (Next.js BFF) environment variables
# Copy to .env and fill in real values. Never commit the real .env file.
#
# IMPORTANT: none of these are prefixed NEXT_PUBLIC_ — that prefix would
# inline the value into the client-side JS bundle. The backend's address and
# the internal signing secret must only ever be read on the server.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# This app's own public origin (used for building absolute redirect URLs).
APP_ORIGIN=http://localhost:3000

# The Nest backend's address. Only ever read inside server-only modules
# (src/lib/server/**) — never sent to the browser, never logged in a client
# error message.
INTERNAL_API_URL=http://localhost:4000

# Must exactly match the backend's INTERNAL_HMAC_SECRET.
INTERNAL_HMAC_SECRET=replace-with-a-random-64-char-hex-string

# ── Stripe webhook (this BFF is the public-facing webhook endpoint — see
# architecture guide for why) ────────────────────────────────────────────
# Keep test AND live values here; STRIPE_MODE picks which is used (blank = live
# when NODE_ENV=production, else test). Keep it identical to the backend's.
STRIPE_MODE=
# Webhook signing secrets (whsec_...) — one per mode, because each Stripe
# destination has its own. Test: Dashboard (test mode) > Developers > Webhooks,
# or `stripe listen` in dev, which prints a whsec_... secret. Live: the live
# destination's secret. The app boots fine without these; the webhook route
# just responds 503 until the active mode's secret is set.
STRIPE_WEBHOOK_SECRET_TEST=whsec_replace_me
STRIPE_WEBHOOK_SECRET_LIVE=
# Single-secret fallback (used if the _TEST/_LIVE variant for the active mode is empty).
STRIPE_WEBHOOK_SECRET=
# Publishable keys — NOT used by the current hosted-Checkout redirect flow;
# listed so they're ready if an embedded card form is ever added.
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY=
# NOTE: secret/restricted API keys (sk_/rk_) belong in the BACKEND .env only.
